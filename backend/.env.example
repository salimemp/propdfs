NODE_ENV=development
PORT=3001

# Supabase (copy from your Supabase dashboard → Project Settings → API)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here

# Supabase PostgreSQL connection string (from Supabase dashboard → Project Settings → Database)
DATABASE_URL=postgresql://postgres:password@db.your-project-id.supabase.co:5432/postgres

# A random secret string you make up (for extra JWT signing if needed)
JWT_SECRET=change-this-to-a-random-long-string

# CORS: allow requests from your frontend (local dev + production)
CORS_ORIGIN=http://localhost:5173,https://www.propdfs.com
