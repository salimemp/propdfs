APP_NAME=ProPDFs
DEBUG=true
ENVIRONMENT=development

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/propdfs
DATABASE_POOL_SIZE=10

# Redis
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Security (generate strong key for production)
SECRET_KEY=your-super-secret-32-character-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# File Storage (Cloudflare R2 or AWS S3)
STORAGE_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
STORAGE_ACCESS_KEY=your-access-key
STORAGE_SECRET_KEY=your-secret-key
STORAGE_BUCKET=propdfs-documents
STORAGE_REGION=auto
MAX_FILE_SIZE_MB=500

# Payments (Stripe)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_BUSINESS=price_...

# AI Services
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=AIzaSy...

# OAuth
GOOGLE_CLIENT_ID=...
GOOGLE_CLIENT_SECRET=...
GITHUB_CLIENT_ID=...
GITHUB_CLIENT_SECRET=...

# Observability (optional — leave empty to disable)
SENTRY_DSN=

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000
# Bot protection (Cloudflare Turnstile)
# Disabled by default — set TURNSTILE_ENABLED=true once you've
# created the widget in Cloudflare and added the matching site key
# to the frontend build (--dart-define=TURNSTILE_SITE_KEY=...).
TURNSTILE_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_VERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify
TURNSTILE_TOKEN_TTL_SECONDS=180

# Per-plan daily quota limits (requests per day, per user)
QUOTA_FREE_AI_PER_DAY=20
QUOTA_FREE_PROCESS_PER_DAY=50
QUOTA_PRO_AI_PER_DAY=500
QUOTA_PRO_PROCESS_PER_DAY=2000
QUOTA_BUSINESS_AI_PER_DAY=-1
QUOTA_BUSINESS_PROCESS_PER_DAY=-1