# VITE_ prefix = exposed to frontend code
# These are NOT secrets — they are public config values

# Supabase (anon key is public — it is safe to expose in frontend)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# Backend API URL
VITE_API_URL=http://localhost:3001
